# Copy this file to .env and fill in your own values.
#
# By default this app runs with a local, in-browser mock data layer — no Firebase
# project or .env file is required to try it out (npm install && npm run dev is enough).
#
# To connect a real Firebase project instead, create one at https://console.firebase.google.com,
# enable Firestore, copy your Web app config into the values below, and set VITE_USE_MOCK=false.

# Set to "false" to use a real Firebase project instead of the built-in mock data layer.
# Leave unset (or "true") to always use mock data, even if the Firebase values below are filled in.
VITE_USE_MOCK=true

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: override the app name shown in the UI.
VITE_APP_NAME=FlowPilot AI
